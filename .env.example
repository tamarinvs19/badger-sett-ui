# Copy to .env and adjust for your environment. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_TIME_ZONE=UTC

# Optional: use a real database instead of the default sqlite.
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=videos
# DJANGO_DB_USER=videos
# DJANGO_DB_PASSWORD=secret
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# Optional: set to true if TLS is terminated far from the app and nginx
# does not forward the X-Forwarded-Proto header.
# DJANGO_SSL_REDIRECT=false